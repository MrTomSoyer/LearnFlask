# API запросы для тестирования
@baseUrl = http://localhost:5000

###
# Регистрация пользователя 1
POST {{baseUrl}}/register
Content-Type: application/json

{
    "username": "Ivan",
    "email": "ivan@mail.com",
    "password": "1234567"
}

###
# Регистрация пользователя 2
POST {{baseUrl}}/register
Content-Type: application/json

{
    "username": "alex",
    "email": "alex@mail.com",
    "password": "123456"
}

###
# Логин пользователя 1
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "Ivan",
  "password": "1234567"
}

###
# Логин пользователя 2
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "alex",
  "password": "123456"
}

###
# Получение всех объявлений. Видят все пользователи
GET {{baseUrl}}/ads
Content-Type: application/json

###
# Создание объявления пользователем, под которым залогинены
POST {{baseUrl}}/ads
Content-Type: application/json

{
  "title": "Кран"
}

###
# Создание объявления пользователем, под которым залогинены
POST {{baseUrl}}/ads
Content-Type: application/json

{
  "title": "Машинка"
}

###
# Создание объявления пользователем, под которым залогинены
POST {{baseUrl}}/ads
Content-Type: application/json

{
  "title": "Столик"
}

###
# Изменение объявления пользователем, под которым залогинены
PATCH {{baseUrl}}/ads/4
Content-Type: application/json

{
  "title": "Гантели 4 шт",
  "description": "Новые гантели"
}

###
# Удаление объявления
DELETE  {{baseUrl}}/ads/3
Content-Type: application/json

###
# Logout
POST  {{baseUrl}}/logout
Content-Type: application/json

{
  "username": "Ivan",
  "password": "1234567"
}

###
# Logout
POST  {{baseUrl}}/logout
Content-Type: application/json

{
  "username": "alex",
  "password": "123456"
}